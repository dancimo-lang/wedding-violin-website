# Supabase
# The project URL and anon key are meant for the browser.
# The service role key bypasses every database permission. Keep it only in
# server environment variables (this file locally, Vercel in production).
# Never prefix it with NEXT_PUBLIC_ and never paste it into frontend code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Also used by the public date check. The check never sends this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (existing)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@danielcimo.com
CONTACT_EMAIL=dancimo@gmail.com

# Wedding agreement email. The sender is the first of these that is set:
# CONTRACT_FROM_EMAIL, then RESEND_FROM, then RESEND_FROM_EMAIL.
# CONTRACT_FROM_EMAIL=
# RESEND_FROM=
# Reply-to defaults to dancimo@gmail.com when CONTRACT_REPLY_TO is unset.
# CONTRACT_REPLY_TO=dancimo@gmail.com
# Optional. The signing link uses the request host when this is unset.
# CONTRACT_PUBLIC_ORIGIN=https://danielcimo.com

# Vercel Blob (existing)
BLOB_READ_WRITE_TOKEN=your-blob-token

# Google Calendar. Server only. Do not prefix any of these with NEXT_PUBLIC_.
# Create the OAuth client in Google Cloud, then paste the client id and secret.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Must match the redirect URI on that OAuth client exactly.
# Local: http://localhost:3000/api/admin/google/callback
# Live site: https://danielcimo.com/api/admin/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/admin/google/callback
# 32-byte key, base64. Generate with: openssl rand -base64 32
# This encrypts the Google refresh token in the database. Do not reuse the client secret.
GOOGLE_TOKEN_ENCRYPTION_KEY=your-base64-encryption-key
# Protects /api/cron/google-sync. Generate a second value with: openssl rand -base64 32
CRON_SECRET=your-cron-secret

# Payments. Server only. Do not prefix any of these with NEXT_PUBLIC_.
# Shared with the Apps Script property of the same name. openssl rand -base64 32
ZELLE_INGEST_SECRET=your-zelle-ingest-secret
# Shown to the couple. Defaults are Daniel Cimo and (224) 678-2799 when unset.
# ZELLE_RECIPIENT_DISPLAY=Daniel Cimo
# ZELLE_RECIPIENT_CONTACT=(224) 678-2799
# Optional replacement for the committed QR. Must be https to be used in email.
# ZELLE_QR_URL=
# Stripe secret key (sk_live_ or sk_test_). Never the publishable key.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Fee defaults are Stripe's published US rates when these are unset:
# cards 2.9% + 30¢ passed on to the couple; ACH 0.8% capped at $5 absorbed.
# Set a flag to false/true to change who pays. Blank ACH cap means no cap.
# STRIPE_CARD_FEE_PERCENT=0.029
# STRIPE_CARD_FEE_FLAT_CENTS=30
# STRIPE_PASS_CARD_FEE=true
# STRIPE_ACH_FEE_PERCENT=0.008
# STRIPE_ACH_FEE_FLAT_CENTS=0
# STRIPE_ACH_FEE_CAP_CENTS=500
# STRIPE_PASS_ACH_FEE=false
